# Copy to `.env` and fill in what you use. `.env` is gitignored — never commit
# real keys. Values are read from the process environment first; the file is a
# development convenience, not a requirement.

# Gemini API — `--vlm` with a `gemini-*` model spec (GOOGLE_API_KEY is
# accepted as a fallback name).
GEMINI_API_KEY=

# OpenAI API — `gpt-*` model specs: `--vlm gpt-6-astra`, or `cadfix` /
# `building` with `--model gpt-6-astra` (their default is gemini-3.8-flash).
OPENAI_API_KEY=

# OpenRouter — `--vlm` with a `vendor/model` spec, e.g. qwen/qwen3-vl-8b-instruct.
OPENROUTER_API_KEY=
